# Copy this file to .env and fill in real values. Never commit the real .env.

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=carleniusai.no,www.carleniusai.no

# Leave DB_NAME unset for local dev to fall back to a local sqlite3 file.
DB_NAME=carlenius_portal
DB_USER=carlenius_portal
DB_PASSWORD=changeme
DB_HOST=127.0.0.1
DB_PORT=5432
